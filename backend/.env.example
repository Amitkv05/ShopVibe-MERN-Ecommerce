# ================================
# APP
# ================================
NODE_ENV=development
PORT=8000

CLIENT_URL=http://localhost:5173
CLIENT_URLS=
API_URL=http://localhost:8000


# ================================
# DATABASE
# ================================
DB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net/Ecommerce?retryWrites=true&w=majority
DB_URI_TEST=

DB_SERVER_SELECTION_TIMEOUT_MS=10000
DB_MAX_POOL_SIZE=20
DB_MIN_POOL_SIZE=0

MONGO_TRANSACTIONS=auto
DNS_SERVERS=


# ================================
# AUTHENTICATION / JWT / COOKIES
# ================================
JWT_SECRET_KEY=replace_with_a_random_secret_at_least_32_characters
JWT_EXPIRE=3d

COOKIE_EXPIRE=2
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

REQUIRE_EMAIL_VERIFICATION=true
EMAIL_VERIFY_TOKEN_MINUTES=1440
RESET_TOKEN_MINUTES=15


# ================================
# SMTP / EMAIL
# ================================
SMTP_SERVICE=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false

SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=


# ================================
# CLOUDINARY
# ================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=mern-ecommerce


# ================================
# RAZORPAY
# Client credentials will be added
# when payment integration is enabled.
# ================================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=


# ================================
# PRICING
# ================================
CURRENCY=INR
TAX_RATE=0
SHIPPING_FLAT_RATE=0
FREE_SHIPPING_THRESHOLD=0


# ================================
# HTTP / LOGGING
# ================================
JSON_BODY_LIMIT=1mb

HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_HEADERS_TIMEOUT_MS=35000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
SHUTDOWN_TIMEOUT_MS=10000

LOG_LEVEL=info


# ================================
# PERFORMANCE TESTING
# ================================
PERF_BASE_URL=http://localhost:8000/api/v1
PERF_REQUESTS=50
PERF_CONCURRENCY=10
PERF_SEARCH_KEYWORD=shirt

PERF_EMAIL=
PERF_PASSWORD=
PERF_VERBOSE=false